@model VlabShop.Web.ViewModels.Catalogue.CatalogueIndexViewModel

@{
    ViewData["Title"] = "Catalogue";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Catalogue</h1>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">View cart</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-6">
        <label for="search" class="form-label">Search products</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Product name" />
    </div>
    <div class="col-md-4">
        <label for="categoryId" class="form-label">Category</label>
        <select id="categoryId" name="categoryId" asp-items="Model.Categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-info">No active products match your search.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model.Products)
    {
        <div class="col">
            <article class="card h-100">
                @if (string.IsNullOrWhiteSpace(product.ImageUrl))
                {
                    <div class="card-img-top d-flex align-items-center justify-content-center bg-light text-muted" style="height: 220px;">No image</div>
                }
                else
                {
                    <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top" style="height: 220px; object-fit: cover;" loading="lazy" />
                }
                <div class="card-body d-flex flex-column">
                    <p class="text-muted mb-1">@product.Category.Name</p>
                    <h2 class="h5 card-title">@product.Name</h2>
                    <p class="fs-5 fw-semibold mb-3">@product.Price.ToString("C")</p>
                    <div class="mt-auto d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary">View details</a>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="ProductId" value="@product.Id" />
                            <input type="hidden" name="Quantity" value="1" />
                            <button type="submit" class="btn btn-primary w-100">Add to cart</button>
                        </form>
                    </div>
                </div>
            </article>
        </div>
    }
    </div>
}
