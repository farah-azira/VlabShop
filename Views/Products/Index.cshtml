@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-primary">Create Product</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Category.Name</td>
            <td>@product.Price.ToString("C")</td>
            <td>@product.StockQuantity</td>
            <td>@(product.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@product.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@product.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@product.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
